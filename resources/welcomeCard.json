{
    "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
    "type": "AdaptiveCard",
    "version": "1.0",
    "body": [
      {
        "type": "Image",
        "url": "https://raw.githubusercontent.com/seanbetts/MiHNDbot/master/resources/MiHND-graphic-logo-black-circle-inverted-rounded.jpg",
        "size": "stretch"
      },
      {
        "type": "TextBlock",
        "spacing": "medium",
        "size": "default",
        "weight": "bolder",
        "text": "Welcome to MiHNDbot!",
        "wrap": true,
        "maxLines": 0
      },
      {
        "type": "TextBlock",
        "size": "default",
        "isSubtle": "yes",
        "text": "I am a chatbot designed to help people understand more about Mental Health and NeuroDiversity. Use the buttons below to find out more or you can chat to me like any other messaging service",
        "wrap": true,
        "maxLines": 0
      }
    ],
    "actions": [
      {
        "type": "Action.Submit",
        "title": "Find Out More About Mental Health",
        "data": "What Is Mental Health?"
      },
      {
        "type": "Action.Submit",
        "title": "Find Out More About NeuroDiversity",
        "data": "What Is NeuroDiversity?"
      },
      {
        "type": "Action.Submit",
        "title": "Get Help",
        "data": "Help Me"
      }
    ]
  }
